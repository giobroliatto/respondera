# Banco de dados PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/respondera"

# Secret usado para assinar os tokens JWT — use uma string longa e aleatória
JWT_SECRET="troque-por-um-secret-longo-e-aleatorio"

# Chave de API da Anthropic (obtenha em https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Porta que o servidor Express vai escutar
PORT=3333

# Origem permitida para CORS — use a URL da extensão Chrome ou * para desenvolvimento
# Exemplo para extensão: chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ORIGIN="*"

PUBLIC_API_URL="http://localhost:3333"

# Em desenvolvimento, deixe vazio para imprimir o link de confirmacao no console.
# Em producao, configure via Resend.
RESEND_API_KEY=""
EMAIL_FROM="Respondera <no-reply@respondera.com.br>"

# Mercado Pago — obtenha em https://www.mercadopago.com.br/developers/panel
# Em desenvolvimento, use as credenciais de TESTE (prefixo TEST-)
# Em producao, use as credenciais de PRODUCAO
MP_ACCESS_TOKEN="TEST-..."
MP_PUBLIC_KEY="TEST-..."

# Assinatura secreta gerada no painel de Webhooks do Mercado Pago
# Em desenvolvimento e producao, o valor vem do painel (Modo de teste / Modo de producao)
MP_WEBHOOK_SECRET=""
